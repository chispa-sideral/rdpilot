# Secrets — generated connection details and credentials live here only (D-06).
# Created in Phase 1 Plan 01 (Pitfall 7) BEFORE any `manage-env.ps1 up` runs so
# .secrets/connection.json can never be staged. Never commit credentials.
.secrets/
.env

# Test output artifacts (Pester -CI writes NUnit XML to the cwd)
testResults.xml

# Compiled Bicep ARM output (`az bicep build` emits main.json next to main.bicep —
# transient compile artifact, source of truth is the .bicep)
infra/*.json

# Rust / Cargo build output (SDK work begins Phase 2; Cargo.lock policy decided then)
/target/
**/*.rs.bk

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# .NET / C# sensor build output (Phase 5, SENSOR-01) — sensor/.gitignore also
# covers this from inside sensor/; duplicated here per plan for a top-level
# `git status` that never shows the NativeAOT publish artifacts as untracked.
sensor/bin/
sensor/obj/
