# Secrets — generated connection details and credentials live here only (D-06).
# Created in Phase 1 Plan 01 (Pitfall 7) BEFORE any `manage-env.ps1 up` runs so
# .secrets/connection.json can never be staged. Never commit credentials.
.secrets/
.env

# Test output artifacts (Pester -CI writes NUnit XML to the cwd)
testResults.xml

# Rust / Cargo build output (SDK work begins Phase 2; Cargo.lock policy decided then)
/target/
**/*.rs.bk

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Generated release payloads and Python caches
/dist/
__pycache__/

# rdpilot-config (Phase 11, CONFIG-02, D-27): the REAL config.toml lives at
# the platform config dir (~/.config/rdpilot/config.toml on Unix,
# %APPDATA%\rdpilot\config.toml on Windows) — structurally outside this repo
# tree, so it can never be accidentally committed from its real location.
# These entries are defensive-only, in case a contributor creates a
# project-local override copy by convention for local dev/testing.
config.toml
.rdpilot.toml
