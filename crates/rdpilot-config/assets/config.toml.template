# rdpilot config.toml — daemon-local settings for rdpilot.
#
# Connection settings (host, port, user, credentials, AcceptInvalidCerts,
# CuaEnabled) do not go here: put them in the hosts file next to this one
# (`hosts`, ssh_config syntax) or pass an rdp:// URL to `rdpilot connect`.
# Old host/port/username/password/domain/accept_invalid_certs keys in this
# file are ignored.
#
# Location (platform convention, resolved via directories::BaseDirs — never
# committed to the repo):
#   Unix:    ~/.config/rdpilot/config.toml
#   Windows: %APPDATA%\rdpilot\config.toml
#
# Every key below can also be set via an environment variable with the
# RDPILOT_ prefix (e.g. RDPILOT_SHARE_ROOT). The environment wins over the file.
#
# All keys are commented out below; an unedited copy of this template
# parses to an all-defaults configuration.

# Local filesystem path of the daemon-local file-transfer staging root that
# backs rdpilot::ConnectionConfig::share_root (put/get, D-10.1/FILE-01/
# FILE-02). This is daemon-local operational config -- it is never sent over
# the wire by a CLI/MCP client's Connect request. Omitting it uses a
# documented platform-data-dir default of <data_dir>/rdpilot/transfer-staging
# (e.g. ~/.local/share/rdpilot/transfer-staging on Linux,
# %APPDATA%\rdpilot\transfer-staging on Windows).
# share_root = "/var/lib/rdpilot/transfer-staging"

# Optional, for offline and development use: a local directory holding
# rdpilot-bridge.exe and/or one Cua archive
# (cua-driver-rs-<version>-windows-x86_64-binary.zip). A file found here is
# used instead of downloading it and is trusted without a checksum; a missing
# one is downloaded (unless CuaAutoDownload is no). Unset: both are downloaded
# and verified automatically. It cannot be set per connect.
# bundle_path = "/absolute/path/to/rdpilot-bundle"

# Read-only live viewer (`rdpilot view`). Nothing listens until you run
# `rdpilot view`; it stops when that command exits.
# [viewer]
# Bind set: "loopback+tailnet" (default) binds 127.0.0.1 and this host's
# Tailscale address; "loopback" binds 127.0.0.1 only. No other address is
# ever bound. Env: RDPILOT_VIEWER__BIND. Flag: rdpilot view --bind.
# bind = "loopback+tailnet"
# Explicit Tailscale IPv4 address when automatic detection finds none or
# several. It must be in 100.64.0.0/10 and present on a local interface.
# Env: RDPILOT_VIEWER__TAILNET_ADDRESS. Flag: rdpilot view --tailnet-address.
# tailnet_address = "100.64.0.1"
